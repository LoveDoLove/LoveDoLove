        <span class="connect-channel">Telegram</span>
        <span class="connect-val">@LoveDoLove</span>
      </div>
      <span class="connect-arrow">↗</span>
    </a>

    <!-- Sponsor -->
    <a href="https://github.com/LoveDoLove/LoveDoLove/blob/main/README-Sponsor.md" target="_blank" rel="noopener noreferrer" class="connect-item">
      <div class="connect-item-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </div>
      <div class="connect-info">
        <span class="connect-channel">Sponsor</span>
        <span class="connect-val">Support Open Source Work</span>
      </div>
      <span class="connect-arrow">↗</span>
    </a>
  </div>
</section>

<style>
  .connect-card {
    margin-bottom: 32px;
  }

  .title-icon {
    color: var(--accent-light);
  }

  .connect-intro {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 20px;
    line-height: 1.6;
  }

  .connect-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .connect-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .connect-item:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(99, 102, 241, 0.35);
    transform: translateY(-2px);
  }

  .connect-item-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(99, 102, 241, 0.12);
    color: var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .connect-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .connect-channel {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .connect-val {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .connect-arrow {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--dim);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .connect-item:hover .connect-arrow {
    color: var(--accent-cyan);
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .connect-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
