        </svg>
      </div>
      <div class="connect-info">
        <span class="connect-channel">GitHub</span>
        <span class="connect-val">@LoveDoLove</span>
      </div>
      <span class="connect-arrow">↗</span>
    </a>

    <!-- Email -->
    <a href="mailto:v0130p5100cuboss@gmail.com" class="connect-item">
      <div class="connect-item-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </div>
      <div class="connect-info">
        <span class="connect-channel">Email</span>
        <span class="connect-val">v0130p5100cuboss@gmail.com</span>
      </div>
      <span class="connect-arrow">↗</span>
    </a>

    <!-- Telegram -->
    <a href="https://t.me/LoveDoLove" target="_blank" rel="noopener noreferrer" class="connect-item">
      <div class="connect-item-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
