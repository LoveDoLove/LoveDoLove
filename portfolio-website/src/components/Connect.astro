        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
      Connect & Contact
    </h2>
    <span class="section-eyebrow">Direct Channels</span>
  </div>

  <p class="connect-intro">
    Open to technical discussions regarding AI agent epistemics, codebase intelligence, developer tooling, or cloud infrastructure.
  </p>

  <div class="connect-grid">
    <!-- GitHub -->
    <a href="https://github.com/LoveDoLove" target="_blank" rel="noopener noreferrer" class="connect-item">
      <div class="connect-item-icon">
