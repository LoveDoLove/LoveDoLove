---
---

<section class="card certs-card" id="certifications">
  <div class="card-header-row">
    <h2>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="title-icon">
        <path d="M12 15l-2 5l9-9l-9-9l2 5l-7 4z"></path>
      </svg>
      Training, Badges & Coursework
    </h2>
    <span class="section-eyebrow">Course Completion & Training</span>
  </div>

  <p class="certs-intro">
    Formal coursework and completion badges in cloud systems architecture, distributed computing, and enterprise networking.
  </p>

  <div class="certs-grid">
    <!-- AWS Academy Cloud Architecting -->
    <div class="cert-item">
      <div class="cert-item-top">
        <div class="cert-icon-box aws-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.75 14.2c-1.85 1.35-4.3 2.05-6.65 2.05-3.3 0-6.3-1.3-8.5-3.45-.15-.15-.15-.35 0-.5.4-.4.8-.8 1.25-1.15.15-.1.35-.1.5 0 1.8 1.7 4.15 2.7 6.7 2.7 1.95 0 3.95-.55 5.55-1.65.2-.15.45-.05.55.15.35.6.7 1.15 1.1 1.7.1.15.05.35-.05.45zM20.2 12.3c-.25-.35-.7-.5-1.1-.35-.45.15-.65.6-.5 1.05.35.95.55 1.95.55 3 0 .45.35.8.8.8s.8-.35.8-.8c0-1.3-.25-2.55-.7-3.7z"/>
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
          </svg>
        </div>
        <span class="cert-status badge-status">Academy Graduate</span>
      </div>
      <h4>AWS Academy Graduate</h4>
      <p class="cert-title">Cloud Architecting</p>
      <div class="cert-meta">
        <span class="cert-issuer">Amazon Web Services Academy</span>
        <span class="cert-topics">Multi-Tier Architecture · VPC · High Availability</span>
      </div>
    </div>

    <!-- AWS Academy Cloud Web App Builder -->
    <div class="cert-item">
      <div class="cert-item-top">
        <div class="cert-icon-box aws-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.75 14.2c-1.85 1.35-4.3 2.05-6.65 2.05-3.3 0-6.3-1.3-8.5-3.45-.15-.15-.15-.35 0-.5.4-.4.8-.8 1.25-1.15.15-.1.35-.1.5 0 1.8 1.7 4.15 2.7 6.7 2.7 1.95 0 3.95-.55 5.55-1.65.2-.15.45-.05.55.15.35.6.7 1.15 1.1 1.7.1.15.05.35-.05.45z"/>
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
          </svg>
        </div>
        <span class="cert-status badge-status">Academy Graduate</span>
      </div>
      <h4>AWS Academy Graduate</h4>
      <p class="cert-title">Cloud Web App Builder</p>
      <div class="cert-meta">
        <span class="cert-issuer">Amazon Web Services Academy</span>
        <span class="cert-topics">Full-Stack Cloud Delivery · Serverless · CI/CD</span>
      </div>
    </div>

    <!-- AWS Academy Cloud Foundations -->
    <div class="cert-item">
      <div class="cert-item-top">
        <div class="cert-icon-box aws-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
          </svg>
        </div>
        <span class="cert-status badge-status">Academy Graduate</span>
      </div>
      <h4>AWS Academy Graduate</h4>
      <p class="cert-title">Cloud Foundations</p>
      <div class="cert-meta">
        <span class="cert-issuer">Amazon Web Services Academy</span>
        <span class="cert-topics">Cloud Concepts · IAM Security · Core Services</span>
      </div>
    </div>

    <!-- AWS Educate Cloud Computing 101 -->
    <div class="cert-item">
      <div class="cert-item-top">
        <div class="cert-icon-box aws-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
          </svg>
        </div>
        <span class="cert-status badge-status">Training Badge</span>
      </div>
      <h4>AWS Educate</h4>
      <p class="cert-title">Cloud Computing 101</p>
      <div class="cert-meta">
        <span class="cert-issuer">AWS Educate</span>
        <span class="cert-topics">Infrastructure Fundamentals · Cloud Storage · Compute</span>
      </div>
    </div>

    <!-- Cisco Networking Coursework -->
    <div class="cert-item cisco-item">
      <div class="cert-item-top">
        <div class="cert-icon-box cisco-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.93V17a1 1 0 0 1-2 0v-.07A7 7 0 0 1 5.07 11H5a1 1 0 0 1 0-2h.07A7 7 0 0 1 11 5.07V5a1 1 0 0 1 2 0v.07A7 7 0 0 1 18.93 11H19a1 1 0 0 1 0 2h-.07A7 7 0 0 1 13 16.93z"/>
          </svg>
        </div>
        <span class="cert-status coursework-status">Coursework (No Official Cert)</span>
      </div>
      <h4>Cisco Networking Academy</h4>
      <p class="cert-title">Networking Coursework</p>
      <div class="cert-meta">
        <span class="cert-issuer">Cisco Networking Academy</span>
        <span class="cert-topics">Subnetting · OSI Model · Routing & Switching (Completed)</span>
      </div>
    </div>
  </div>
</section>

<style>
  .certs-card {
    margin-bottom: 32px;
  }

  .title-icon {
    color: var(--accent-light);
  }

  .certs-intro {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 20px;
    line-height: 1.6;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
  }

  .cert-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
  }

  .cert-item:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
  }

  .cert-item-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .cert-icon-box {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .aws-box {
    background: rgba(255, 153, 0, 0.12);
    color: #ff9900;
    border: 1px solid rgba(255, 153, 0, 0.25);
  }

  .cisco-box {
    background: rgba(0, 188, 242, 0.12);
    color: #00bcf2;
    border: 1px solid rgba(0, 188, 242, 0.25);
  }

  .cert-status {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.03em;
  }

  .badge-status {
    background: var(--accent-emerald-bg);
    color: var(--accent-emerald);
    border: 1px solid rgba(16, 185, 129, 0.22);
  }

  .coursework-status {
    background: rgba(255, 255, 255, 0.04);
    color: var(--muted);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cert-item h4 {
    margin: 0 0 4px;
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cert-title {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
  }

  .cert-meta {
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cert-issuer {
    font-size: 11.5px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .cert-topics {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim);
  }

  @media (max-width: 640px) {
    .certs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
