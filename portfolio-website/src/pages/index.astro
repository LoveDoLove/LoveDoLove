---
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import TechnicalFocus from "../components/TechnicalFocus.astro";
import Certifications from "../components/Certifications.astro";
import Stats from "../components/Stats.astro";
import Connect from "../components/Connect.astro";
import Footer from "../components/Footer.astro";

const CANONICAL_URL = "https://portfolio.lovedolove.qzz.io";
const SITE_TITLE = "LoveDoLove — Software Engineer | AI Coding Agents · Developer Tooling · Cloud Infrastructure";
const SITE_DESCRIPTION = "Engineering portfolio of LoveDoLove — Software Engineer building epistemic memory for autonomous coding agents, codebase intelligence infrastructure, and resilient edge systems. Creator of Veyra and dsh-codebase-memory-mcp.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b12" />
    <link rel="canonical" href={CANONICAL_URL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={SITE_DESCRIPTION} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={CANONICAL_URL} />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:image" content="https://avatars.githubusercontent.com/u/67772009?v=4" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={SITE_TITLE} />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <meta name="twitter:image" content="https://avatars.githubusercontent.com/u/67772009?v=4" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "LoveDoLove",
      "url": CANONICAL_URL,
      "jobTitle": "Software Engineer",
      "knowsAbout": [
        "AI Coding Agents",
        "Epistemic Memory Systems",
        "Developer Tooling",
        "Model Context Protocol (MCP)",
        "Cloudflare Workers",
        "Distributed Edge Systems"
      ],
      "sameAs": [
        "https://github.com/LoveDoLove"
      ]
    })} />

    <style is:global>
      :root {
        --bg: #080b12;
        --bg-subtle: #0d121f;
        --card-bg: rgba(13, 18, 31, 0.78);
        --card-hover-bg: rgba(18, 26, 44, 0.9);
        --card-border: rgba(255, 255, 255, 0.08);
        --card-border-hover: rgba(99, 102, 241, 0.35);
        --card-border-top: rgba(99, 102, 241, 0.22);
        --text: #f8fafc;
        --text-secondary: #cbd5e1;
        --muted: #94a3b8;
        --dim: #64748b;
        --accent: #6366f1;
        --accent-light: #818cf8;
        --accent-cyan: #38bdf8;
        --accent-cyan-bg: rgba(56, 189, 248, 0.08);
        --accent-emerald: #10b981;
        --accent-emerald-bg: rgba(16, 185, 129, 0.08);
        --badge-bg: rgba(99, 102, 241, 0.1);
        --badge-border: rgba(99, 102, 241, 0.22);
        --badge-text: #c7d2fe;
        --font-mono: ui-monospace, "JetBrains Mono", "Cascadia Code", "Fira Code", monospace;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Roboto, "Helvetica Neue", Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: var(--bg);
        background-image:
          radial-gradient(ellipse 70% 40% at 50% -10%, rgba(99, 102, 241, 0.14), transparent 70%),
          radial-gradient(ellipse 60% 30% at 85% 20%, rgba(56, 189, 248, 0.07), transparent 60%),
          radial-gradient(ellipse 50% 30% at 15% 40%, rgba(129, 140, 248, 0.05), transparent 50%);
        background-attachment: fixed;
        color: var(--text);
        font-family: var(--font-sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .container {
        max-width: 940px;
        margin: 0 auto;
        padding: 48px 24px 80px;
      }

      .card {
        background: var(--card-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--card-border);
        border-radius: 14px;
        padding: 28px;
        margin-bottom: 28px;
        box-shadow:
          0 4px 20px -2px rgba(0, 0, 0, 0.5),
          inset 0 1px 0 0 var(--card-border-top);
        transition:
          border-color 0.22s cubic-bezier(0.16, 1, 0.3, 1),
          box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .card-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding-bottom: 14px;
      }

      .section-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent-cyan);
        background: var(--accent-cyan-bg);
        border: 1px solid rgba(56, 189, 248, 0.2);
        padding: 3px 8px;
        border-radius: 5px;
      }

      .card h2 {
        font-size: 22px;
        font-weight: 700;
        margin: 0;
        color: var(--text);
        letter-spacing: -0.02em;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      a {
        color: var(--accent-light);
        text-decoration: none;
        transition: color 0.15s ease;
      }

      a:hover {
        color: var(--accent-cyan);
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.9em;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 2px 6px;
        border-radius: 5px;
        color: #e2e8f0;
      }

      @media (max-width: 640px) {
        .container {
          padding: 24px 14px 48px;
        }
        .card {
          padding: 20px 16px;
          border-radius: 12px;
          margin-bottom: 20px;
        }
        .card-header-row {
          flex-direction: column;
          align-items: flex-start;
          gap: 8px;
        }
        .card h2 {
          font-size: 19px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <Header />
      <About />
      <FeaturedProjects />
      <TechnicalFocus />
      <Certifications />
      <Stats />
      <Connect />
      <Footer />
    </div>
  </body>
</html>
