    font-size: 22px;
    font-weight: 700;
    margin: 0 0 16px;
    color: var(--text);
    border-bottom: 1px solid var(--card-border);
    padding-bottom: 10px;
  }

  .content-section h3 {
    font-size: 17px;
    font-weight: 600;
    margin: 24px 0 12px;
    color: var(--accent-light);
  }

  .content-section p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 16px;
  }

  .content-section strong {
    color: var(--text);
  }

  .content-section code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--accent-cyan);
  }

  /* Callouts */
  .callout {
    display: flex;
    gap: 14px;
    padding: 16px;
    border-radius: 8px;
    margin: 20px 0;
  }

  .warning-callout {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    color: #fbbf24;
  }

  .callout-icon {
    font-size: 20px;
    line-height: 1;
  }

  .callout-body {
    font-size: 14px;
    color: #fde68a;
    line-height: 1.6;
  }

  .callout-body strong {
    color: #fff;
  }

  /* Principles list */
  .principles {
    list-style: none;
    padding: 0;
    margin: 16px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .principles li {
    padding: 12px 16px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
